{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorise.example/schemas/runner-conformance-manifest-1.json",
  "title": "EvoOM Guard runner conformance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "suite_id",
    "report_path",
    "discovery_timeout_seconds",
    "owners",
    "registry_order",
    "inner_registry_order",
    "cases",
    "registry_cases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "evoom-runner-conformance-manifest-1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    },
    "discovery_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "owners": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "registry_order": {
      "$ref": "#/$defs/owner_order"
    },
    "inner_registry_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/owner_id"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/owner_case"
      }
    },
    "registry_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/registry_case"
      }
    }
  },
  "$defs": {
    "owner_id": {
      "enum": [
        "shell",
        "pytest",
        "node_test",
        "vitest",
        "jest",
        "gotestsum",
        "rspec",
        "mocha",
        "maven"
      ]
    },
    "owner_order": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/owner_id"
      }
    },
    "string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "string_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "class",
        "adapter_name",
        "discovery_argv"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/owner_id"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "adapter_name": {
          "type": "string",
          "minLength": 1
        },
        "discovery_argv": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched",
        "applied",
        "argv",
        "env"
      ],
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "env": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "registry_expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_owner",
        "matched",
        "applied",
        "argv",
        "env"
      ],
      "properties": {
        "selected_owner": {
          "oneOf": [
            {
              "$ref": "#/$defs/owner_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "env": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "owner_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "category",
        "argv",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/owner_id"
        },
        "category": {
          "enum": [
            "accept",
            "decline",
            "mismatch",
            "windows_path",
            "shell"
          ]
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "registry_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "expected": {
          "$ref": "#/$defs/registry_expected"
        }
      }
    }
  }
}
