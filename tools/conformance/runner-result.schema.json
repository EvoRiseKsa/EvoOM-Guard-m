{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorise.example/schemas/runner-conformance-result-1.json",
  "title": "EvoOM Guard runner conformance result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "suite_id",
    "run_id",
    "started_at_utc",
    "finished_at_utc",
    "status",
    "status_basis",
    "claims",
    "manifest",
    "source",
    "reproduce",
    "owners",
    "registry",
    "cases",
    "live_tool_discovery",
    "summary"
  ],
  "properties": {
    "$schema": {
      "const": "tools/conformance/runner-result.schema.json"
    },
    "schema_version": {
      "const": "evoom-runner-conformance-result-1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "status_basis": {
      "const": "offline_adapter_contract_only"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_adapter_contract_executed",
        "external_runner_suites_executed",
        "multi_os_real_runner_matrix_published"
      ],
      "properties": {
        "offline_adapter_contract_executed": {
          "const": true
        },
        "external_runner_suites_executed": {
          "const": false
        },
        "multi_os_real_runner_matrix_published": {
          "const": false
        }
      }
    },
    "manifest": {
      "$ref": "#/$defs/bound_file"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "reproduce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "owners": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/identity_result"
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "cases"
      ],
      "properties": {
        "order": {
          "$ref": "#/$defs/order_result"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/registry_case_result"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/owner_case_result"
      }
    },
    "live_tool_discovery": {
      "$ref": "#/$defs/discovery"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_checks",
        "passed",
        "failed",
        "tool_versions_observed",
        "tool_versions_unsupported"
      ],
      "properties": {
        "offline_checks": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "tool_versions_observed": {
          "type": "integer",
          "minimum": 0
        },
        "tool_versions_unsupported": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "owner_id": {
      "enum": [
        "shell",
        "pytest",
        "node_test",
        "vitest",
        "jest",
        "gotestsum",
        "rspec",
        "mocha",
        "maven"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "logical_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/).+"
    },
    "string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "string_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "bound_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/logical_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "kit_version",
        "python",
        "platform",
        "git_commit",
        "git_dirty",
        "files",
        "aggregate_sha256"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "kit_version": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "release",
            "machine"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1
            },
            "release": {
              "type": "string",
              "minLength": 1
            },
            "machine": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "git_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bound_file"
          }
        },
        "aggregate_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "class",
        "adapter_name"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "adapter_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "expected",
        "observed",
        "mismatch_fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/owner_id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "expected": {
          "$ref": "#/$defs/identity"
        },
        "observed": {
          "$ref": "#/$defs/identity"
        },
        "mismatch_fields": {
          "$ref": "#/$defs/mismatch_fields"
        }
      }
    },
    "owner_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 9,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/owner_id"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "order_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expected",
        "observed",
        "expected_inner",
        "observed_inner",
        "mismatch_fields"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "expected": {
          "$ref": "#/$defs/owner_order"
        },
        "observed": {
          "$ref": "#/$defs/owner_order"
        },
        "expected_inner": {
          "$ref": "#/$defs/owner_order"
        },
        "observed_inner": {
          "$ref": "#/$defs/owner_order"
        },
        "mismatch_fields": {
          "$ref": "#/$defs/mismatch_fields"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched",
        "applied",
        "argv",
        "env"
      ],
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "env": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "registry_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_owner",
        "matched",
        "applied",
        "argv",
        "env"
      ],
      "properties": {
        "selected_owner": {
          "oneOf": [
            {
              "$ref": "#/$defs/owner_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched": {
          "type": "boolean"
        },
        "applied": {
          "type": "boolean"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "env": {
          "$ref": "#/$defs/string_map"
        }
      }
    },
    "mismatch_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner_case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "category",
        "status",
        "expected",
        "observed",
        "mismatch_fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "$ref": "#/$defs/owner_id"
        },
        "category": {
          "enum": [
            "accept",
            "decline",
            "mismatch",
            "windows_path",
            "shell"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "expected": {
          "$ref": "#/$defs/contract"
        },
        "observed": {
          "$ref": "#/$defs/contract"
        },
        "mismatch_fields": {
          "$ref": "#/$defs/mismatch_fields"
        }
      }
    },
    "registry_case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "expected",
        "observed",
        "mismatch_fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "expected": {
          "$ref": "#/$defs/registry_contract"
        },
        "observed": {
          "$ref": "#/$defs/registry_contract"
        },
        "mismatch_fields": {
          "$ref": "#/$defs/mismatch_fields"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "non_gating",
        "proves_runner_execution",
        "tools"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "non_gating": {
          "const": true
        },
        "proves_runner_execution": {
          "const": false
        },
        "tools": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/discovery_observed"
              },
              {
                "$ref": "#/$defs/discovery_unsupported"
              }
            ]
          }
        }
      }
    },
    "discovery_observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "argv",
        "status",
        "version"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner_id"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "status": {
          "const": "observed"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+._][A-Za-z0-9.-]+)?$"
        }
      }
    },
    "discovery_unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "argv",
        "status",
        "reason"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner_id"
        },
        "argv": {
          "$ref": "#/$defs/string_array"
        },
        "status": {
          "const": "unsupported"
        },
        "reason": {
          "enum": [
            "not_found",
            "timeout",
            "output_limit",
            "process_error",
            "nonzero",
            "version_unparseable"
          ]
        }
      }
    }
  }
}
