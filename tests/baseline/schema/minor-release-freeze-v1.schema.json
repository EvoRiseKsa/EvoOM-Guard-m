{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evoguard:minor-release-freeze:1",
  "title": "EvoOM Guard minor release freeze declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "state",
    "version",
    "source_version",
    "declaration",
    "scope",
    "compatibility"
  ],
  "properties": {
    "format": {"const": "EVOGUARD_MINOR_RELEASE_FREEZE_V1"},
    "state": {
      "enum": ["POST_MERGE_DECLARATION_REQUIRED", "FROZEN"]
    },
    "version": {"const": "4.7.0"},
    "source_version": {"const": "4.7.0.dev0"},
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_parent_commit_sha",
        "frozen_parent_tree_sha",
        "started_at",
        "not_before",
        "stabilization_seconds"
      ],
      "properties": {
        "frozen_parent_commit_sha": {"$ref": "#/$defs/shaOrPlaceholder"},
        "frozen_parent_tree_sha": {"$ref": "#/$defs/shaOrPlaceholder"},
        "started_at": {"$ref": "#/$defs/dateOrPlaceholder"},
        "not_before": {"$ref": "#/$defs/dateOrPlaceholder"},
        "stabilization_seconds": {"const": 1209600}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_promotion_policy",
        "candidate_promotion_paths",
        "stabilization_window_allowed_changes",
        "scope_sha256"
      ],
      "properties": {
        "candidate_promotion_policy": {
          "const": "exact-stable-promotion-scope-only"
        },
        "candidate_promotion_paths": {
          "const": [
            "CHANGELOG.md",
            "PROJECT_STATUS.json",
            "README.md",
            "ROADMAP.md",
            "SECURITY.md",
            "docs/GITHUB_ARTIFACT_ATTESTATIONS.md",
            "docs/PROJECT_STATUS.md",
            "docs/RELEASE_STATUS.md",
            "docs/SBOM.md",
            "docs/architecture/REFACTOR_PROGRAM.md",
            "evoom_guard/__init__.py"
          ]
        },
        "stabilization_window_allowed_changes": {
          "const": ["release-record-corrections-only"]
        },
        "scope_sha256": {
          "const": "85682b273bc72ddaed4070d25d45ac7da9c3ef4dd21e8b60e2be1fb91ee98e75"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "required_documents"],
      "properties": {
        "classification": {"const": "compatible-minor"},
        "required_documents": {
          "const": ["CHANGELOG.md", "README.md", "docs/RELEASE_STATUS.md"]
        }
      }
    }
  },
  "$defs": {
    "shaOrPlaceholder": {
      "anyOf": [
        {"const": "POST_MERGE_REQUIRED"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "dateOrPlaceholder": {
      "anyOf": [
        {"const": "POST_MERGE_REQUIRED"},
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ]
    }
  }
}
