{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoOM Guard maintained direct release record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_utc",
    "record_scope",
    "maintainer_signature_contract",
    "repository",
    "source",
    "tag",
    "release",
    "assets",
    "workflow",
    "prepublication",
    "verification_observations",
    "provider_control_observation",
    "historical_evidence",
    "trust_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "evoguard-direct-release-record-v1"
    },
    "recorded_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "record_scope": {
      "const": "Maintained same-owner post-publication record for simple-release-v1; not a release ledger, independent review, or substitute for either."
    },
    "maintainer_signature_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "identity",
        "namespace",
        "signature_path",
        "public_key_path",
        "public_key_metadata_path",
        "public_key_sha256",
        "public_key_metadata_sha256",
        "public_key_fingerprint"
      ],
      "properties": {
        "purpose": {
          "const": "Authenticate the exact maintained post-publication record bytes without upgrading same-owner observations into independent release evidence."
        },
        "identity": {
          "const": "EvoRiseKsa"
        },
        "namespace": {
          "const": "git"
        },
        "signature_path": {
          "type": "string",
          "pattern": "^evidence/direct-releases/v[0-9]+\\.[0-9]+\\.[0-9]+/DIRECT_RELEASE\\.json\\.sig$"
        },
        "public_key_path": {
          "const": "security/release-maintainer-roots/v4.7.0.pub"
        },
        "public_key_metadata_path": {
          "const": "security/release-maintainer-roots/v4.7.0.json"
        },
        "public_key_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_key_metadata_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "public_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository_id", "owner_login", "owner_id"],
      "properties": {
        "name": {"const": "EvoRiseKsa/EvoOM-Guard-m"},
        "repository_id": {"$ref": "#/$defs/positive_integer"},
        "owner_login": {"const": "EvoRiseKsa"},
        "owner_id": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit_sha",
        "tree_sha",
        "ref",
        "github_verification"
      ],
      "properties": {
        "version": {"$ref": "#/$defs/stable_version"},
        "commit_sha": {"$ref": "#/$defs/sha1"},
        "tree_sha": {"$ref": "#/$defs/sha1"},
        "ref": {"const": "refs/heads/main"},
        "github_verification": {"$ref": "#/$defs/verification"}
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "object_type",
        "object_sha",
        "target_type",
        "target_sha",
        "github_verification",
        "maintainer_key_fingerprint"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/tag"},
        "object_type": {"const": "tag"},
        "object_sha": {"$ref": "#/$defs/sha1"},
        "target_type": {"const": "commit"},
        "target_sha": {"$ref": "#/$defs/sha1"},
        "github_verification": {"$ref": "#/$defs/verification"},
        "maintainer_key_fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "name",
        "tag",
        "target_commit_sha",
        "draft",
        "prerelease",
        "immutable",
        "created_utc",
        "created_utc_semantics",
        "published_utc",
        "release_url",
        "body_sha256",
        "body_sha256_semantics",
        "author"
      ],
      "properties": {
        "release_id": {"$ref": "#/$defs/positive_integer"},
        "name": {"$ref": "#/$defs/tag"},
        "tag": {"$ref": "#/$defs/tag"},
        "target_commit_sha": {"$ref": "#/$defs/sha1"},
        "draft": {"const": false},
        "prerelease": {"const": false},
        "immutable": {"const": true},
        "created_utc": {"$ref": "#/$defs/timestamp"},
        "created_utc_semantics": {"type": "string", "minLength": 1},
        "published_utc": {"$ref": "#/$defs/timestamp"},
        "release_url": {
          "type": "string",
          "pattern": "^https://github\\.com/EvoRiseKsa/EvoOM-Guard-m/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "body_sha256": {"$ref": "#/$defs/sha256"},
        "body_sha256_semantics": {"type": "string", "minLength": 1},
        "author": {"$ref": "#/$defs/github_actor"}
      }
    },
    "assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset"},
      "allOf": [
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "evo-guard.pyz"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "evo-guard.spdx.json"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "SHA256SUMS"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "run_id",
        "run_attempt",
        "workflow_id",
        "workflow_path",
        "workflow_blob_sha",
        "workflow_sha256",
        "verifier_path",
        "verifier_blob_sha",
        "verifier_sha256",
        "event",
        "ref",
        "head_sha",
        "actor",
        "triggering_actor",
        "conclusion",
        "jobs",
        "deployments"
      ],
      "properties": {
        "contract": {"const": "simple-release-v1"},
        "run_id": {"$ref": "#/$defs/positive_integer"},
        "run_attempt": {"const": 1},
        "workflow_id": {"$ref": "#/$defs/positive_integer"},
        "workflow_path": {"const": ".github/workflows/release.yml"},
        "workflow_blob_sha": {"$ref": "#/$defs/sha1"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_path": {"const": ".github/workflows/release-published-verify.yml"},
        "verifier_blob_sha": {"$ref": "#/$defs/sha1"},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "event": {"const": "workflow_dispatch"},
        "ref": {"const": "refs/heads/main"},
        "head_sha": {"$ref": "#/$defs/sha1"},
        "actor": {"$ref": "#/$defs/maintainer_actor"},
        "triggering_actor": {"$ref": "#/$defs/maintainer_actor"},
        "conclusion": {"const": "success"},
        "jobs": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/job"}
        },
        "deployments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/deployment"}
        }
      }
    },
    "prepublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_ci", "action_smoke"],
      "properties": {
        "tag_ci": {"$ref": "#/$defs/prepublication_run"},
        "action_smoke": {"$ref": "#/$defs/prepublication_run"}
      }
    },
    "verification_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_attestation",
        "provider_attestation_job",
        "post_publication_byte_readback"
      ],
      "properties": {
        "release_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified", "command", "subjects"],
          "properties": {
            "verified": {"const": true},
            "command": {"type": "string", "minLength": 1},
            "subjects": {"$ref": "#/$defs/release_subjects"}
          }
        },
        "provider_attestation_job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "build_provenance_subjects",
            "sbom_subjects",
            "signer_workflow"
          ],
          "properties": {
            "conclusion": {"const": "success"},
            "build_provenance_subjects": {"const": ["evo-guard.pyz"]},
            "sbom_subjects": {"const": ["evo-guard.pyz"]},
            "signer_workflow": {"const": ".github/workflows/release.yml"}
          }
        },
        "post_publication_byte_readback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "release_id",
            "release_body_sha256",
            "release_body_sha256_semantics",
            "asset_ids",
            "asset_sha256",
            "sha256sums_lines"
          ],
          "properties": {
            "verified": {"const": true},
            "release_id": {"$ref": "#/$defs/positive_integer"},
            "release_body_sha256": {"$ref": "#/$defs/sha256"},
            "release_body_sha256_semantics": {"type": "string", "minLength": 1},
            "asset_ids": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/positive_integer"}
            },
            "asset_sha256": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/sha256"}
            },
            "sha256sums_lines": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}  (evo-guard\\.pyz|evo-guard\\.spdx\\.json)$"
              }
            }
          }
        }
      }
    },
    "provider_control_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_utc",
        "immutable_releases_enabled",
        "main_ruleset",
        "tag_ruleset"
      ],
      "properties": {
        "observed_utc": {"$ref": "#/$defs/timestamp"},
        "immutable_releases_enabled": {"const": true},
        "main_ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "enforcement", "bypass_actor_count"],
          "properties": {
            "id": {"$ref": "#/$defs/positive_integer"},
            "name": {"const": "EvoOM Guard main signed-source authority"},
            "enforcement": {"const": "active"},
            "bypass_actor_count": {"const": 0}
          }
        },
        "tag_ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "enforcement",
            "bypass_actor_type",
            "active_deploy_key_count"
          ],
          "properties": {
            "id": {"$ref": "#/$defs/positive_integer"},
            "name": {"const": "EvoOM Guard release tag authority"},
            "enforcement": {"const": "active"},
            "bypass_actor_type": {"const": "DeployKey"},
            "active_deploy_key_count": {"const": 0}
          }
        }
      }
    },
    "historical_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_validated_a_h_ledger", "applies_to_this_release"],
      "properties": {
        "latest_validated_a_h_ledger": {
          "type": "string",
          "pattern": "^evidence/release-ledgers/v[0-9]+\\.[0-9]+\\.[0-9]+/RELEASE_LEDGER\\.json$"
        },
        "applies_to_this_release": {"const": false}
      }
    },
    "trust_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_owner_operation",
        "independent_review",
        "record_included_in_release_tag",
        "record_included_in_release_assets",
        "non_claims"
      ],
      "properties": {
        "same_owner_operation": {"const": true},
        "independent_review": {"const": false},
        "record_included_in_release_tag": {"const": false},
        "record_included_in_release_assets": {"const": false},
        "non_claims": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "positive_integer": {"type": "integer", "minimum": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "reason"],
      "properties": {
        "verified": {"const": true},
        "reason": {"const": "valid"}
      }
    },
    "github_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "id", "type"],
      "properties": {
        "login": {"const": "github-actions[bot]"},
        "id": {"$ref": "#/$defs/positive_integer"},
        "type": {"const": "Bot"}
      }
    },
    "maintainer_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "id"],
      "properties": {
        "login": {"const": "EvoRiseKsa"},
        "id": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "asset_id",
        "size",
        "sha256",
        "content_type",
        "label",
        "state",
        "uploader",
        "url"
      ],
      "properties": {
        "name": {"enum": ["evo-guard.pyz", "evo-guard.spdx.json", "SHA256SUMS"]},
        "asset_id": {"$ref": "#/$defs/positive_integer"},
        "size": {"$ref": "#/$defs/positive_integer"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_type": {"const": "application/octet-stream"},
        "label": {"const": ""},
        "state": {"const": "uploaded"},
        "uploader": {"$ref": "#/$defs/github_actor"},
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/EvoRiseKsa/EvoOM-Guard-m/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/(evo-guard\\.pyz|evo-guard\\.spdx\\.json|SHA256SUMS)$"
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "job_id", "conclusion"],
      "properties": {
        "name": {
          "enum": [
            "validate-test",
            "dispatch-ref-guard",
            "release-e2e",
            "release-windows-e2e",
            "build-artifact",
            "attest-release-assets",
            "prepare-draft",
            "publish-release",
            "post-publication-verify / verify-published-release"
          ]
        },
        "job_id": {"$ref": "#/$defs/positive_integer"},
        "conclusion": {"const": "success"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "environment_id",
        "deployment_id",
        "terminal_status_id",
        "terminal_state"
      ],
      "properties": {
        "environment": {
          "enum": ["evoguard-release-draft", "evoguard-release-publication"]
        },
        "environment_id": {"$ref": "#/$defs/positive_integer"},
        "deployment_id": {"$ref": "#/$defs/positive_integer"},
        "terminal_status_id": {"$ref": "#/$defs/positive_integer"},
        "terminal_state": {"const": "success"}
      }
    },
    "prepublication_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "workflow_id",
        "head_sha",
        "ref",
        "run_attempt",
        "conclusion",
        "successful_jobs",
        "total_jobs"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/positive_integer"},
        "workflow_id": {"$ref": "#/$defs/positive_integer"},
        "head_sha": {"$ref": "#/$defs/sha1"},
        "ref": {
          "type": "string",
          "pattern": "^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "run_attempt": {"const": 1},
        "conclusion": {"const": "success"},
        "successful_jobs": {"$ref": "#/$defs/positive_integer"},
        "total_jobs": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "release_subjects": {
      "const": ["evo-guard.pyz", "evo-guard.spdx.json", "SHA256SUMS"]
    }
  }
}
