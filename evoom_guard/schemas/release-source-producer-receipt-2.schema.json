{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvoRiseKsa/EvoOM-Guard-m/v4.6.0/evoom_guard/schemas/release-source-producer-receipt-2.schema.json",
  "title": "EvoGuard separated maintenance producer receipt V2",
  "$comment": "Standard Draft 2020-12 validation is structural and treats mathematically integral numbers such as 1.0 as integers; EvoGuard runtime canonical-byte validation is the security authority for exact scalar categories and encodings.",
  "type": "object",
  "required": ["format", "subject", "context", "upstream", "record", "handoff", "bootstrap", "execution", "producer"],
  "properties": {
    "format": { "const": "EVOGUARD_RELEASE_SOURCE_PRODUCER_RECEIPT_V2" },
    "subject": { "$ref": "release-source-2.schema.json" },
    "context": { "$ref": "release-source-context-2.schema.json" },
    "upstream": { "$ref": "release-source-context-2.schema.json#/$defs/run" },
    "record": { "$ref": "#/$defs/recordDescriptor" },
    "handoff": { "$ref": "#/$defs/handoffDescriptor" },
    "bootstrap": {
      "type": "object",
      "required": ["runtime_identity_format", "guard_artifact_sha256"],
      "properties": {
        "runtime_identity_format": { "const": "EVOGUARD_GUARD_ZIPAPP_SHA256_V2" },
        "guard_artifact_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["outcome", "guard_exit_code", "candidate_isolation", "network", "report_integrity", "overall_profile"],
      "properties": {
        "outcome": { "const": "PASS" },
        "guard_exit_code": { "const": 0 },
        "candidate_isolation": { "enum": ["docker", "gvisor"] },
        "network": { "const": "none" },
        "report_integrity": { "const": "external_process_isolated" },
        "overall_profile": { "const": "black_box_external_judge" }
      },
      "additionalProperties": false
    },
    "producer": { "$ref": "#/$defs/actor" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitDigest": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "numericId": { "type": "string", "pattern": "^[1-9][0-9]{0,255}$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]{1,100}$" },
    "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9_.-]*\\.ya?ml$", "maxLength": 256 },
    "recordDescriptor": {
      "type": "object", "required": ["sha256", "size"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "size": { "type": "integer", "minimum": 1, "maximum": 8388608 } },
      "additionalProperties": false
    },
    "handoffDescriptor": {
      "type": "object", "required": ["sha256", "size"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "size": { "type": "integer", "minimum": 1, "maximum": 524288 } },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": [
        "workflow_repository", "workflow_repository_id", "workflow_id", "workflow_path", "workflow_blob_sha",
        "workflow_run_id", "workflow_run_attempt", "workflow_event", "workflow_ref", "workflow_commit_sha",
        "workflow_tree_sha", "upstream_run_id", "upstream_run_attempt", "runner_class"
      ],
      "properties": {
        "workflow_repository": { "$ref": "#/$defs/repository" },
        "workflow_repository_id": { "$ref": "#/$defs/numericId" },
        "workflow_id": { "$ref": "#/$defs/numericId" },
        "workflow_path": { "$ref": "#/$defs/workflowPath" },
        "workflow_blob_sha": { "$ref": "#/$defs/gitDigest" },
        "workflow_run_id": { "$ref": "#/$defs/numericId" },
        "workflow_run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "workflow_event": { "const": "workflow_run" },
        "workflow_ref": { "const": "refs/heads/main" },
        "workflow_commit_sha": { "$ref": "#/$defs/gitDigest" },
        "workflow_tree_sha": { "$ref": "#/$defs/gitDigest" },
        "upstream_run_id": { "$ref": "#/$defs/numericId" },
        "upstream_run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "runner_class": { "const": "github-hosted" }
      },
      "additionalProperties": false
    }
  }
}
