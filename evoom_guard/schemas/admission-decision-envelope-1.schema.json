{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvoRiseKsa/EvoOM-Guard-m/v4.6.0/evoom_guard/schemas/admission-decision-envelope-1.schema.json",
  "title": "EvoOM Guard Admission Decision Envelope V1",
  "description": "A canonical in-toto Statement projection of one independently verified Agent Change proof. Structural schema validation alone does not grant admission authority.",
  "$comment": "The runtime validator additionally enforces exact Python scalar categories, canonical JSON bytes, cross-field equality, and finalizer/change-authorization key separation. Draft 2020-12 treats integral JSON numbers such as 1.0 as integers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^git\\+https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]{1,100}@[0-9a-f]{40}(?:[0-9a-f]{24})?$"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gitCommit"],
            "properties": {"gitCommit": {"$ref": "#/$defs/gitDigest"}}
          }
        }
      }
    },
    "predicateType": {
      "const": "https://schemas.evorise.tech/evoom-guard/admission-decision/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "profile", "decision", "subject", "controls", "proof", "authority"],
      "properties": {
        "format": {"const": "EVOGUARD_ADMISSION_DECISION_ENVELOPE_V1"},
        "profile": {"const": "agent-change"},
        "decision": {"const": "ALLOW"},
        "subject": {"$ref": "#/$defs/changeSubject"},
        "controls": {"$ref": "#/$defs/controls"},
        "proof": {"$ref": "#/$defs/proof"},
        "authority": {"$ref": "#/$defs/authority"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitDigest": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "keyId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]{1,100}$"
    },
    "changeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "repository_id", "pull_request_number", "base_sha", "base_tree_sha", "head_sha", "head_tree_sha", "candidate_sha256", "candidate_size"],
      "properties": {
        "kind": {"const": "git-change"},
        "repository": {"$ref": "#/$defs/repository"},
        "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,255}$"},
        "pull_request_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "base_sha": {"$ref": "#/$defs/gitDigest"},
        "base_tree_sha": {"$ref": "#/$defs/gitDigest"},
        "head_sha": {"$ref": "#/$defs/gitDigest"},
        "head_tree_sha": {"$ref": "#/$defs/gitDigest"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_size": {"type": "integer", "minimum": 1, "maximum": 67108864}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_sha256", "verifier_pack_sha256"],
      "properties": {
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "verifier_pack_sha256": {
          "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "authenticator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "purpose"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"$ref": "#/$defs/keyId"},
        "purpose": {"type": "string"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "size", "authentication"],
      "properties": {
        "format": {"const": "EVOGUARD_EVIDENCE_BUNDLE_V1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 69206016},
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finalizer", "change_authorization"],
          "properties": {
            "finalizer": {
              "allOf": [
                {"$ref": "#/$defs/authenticator"},
                {"properties": {"purpose": {"const": "evoguard-evidence-envelope"}}}
              ]
            },
            "change_authorization": {
              "allOf": [
                {"$ref": "#/$defs/authenticator"},
                {"properties": {"purpose": {"const": "evoguard-agent-change-authorization-v1"}}}
              ]
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "admission_scope", "merge", "publication", "deployment", "external_action"],
      "properties": {
        "mode": {"const": "PROOF_BOUND_PROJECTION"},
        "admission_scope": {"const": "repository-change"},
        "merge": {"const": false},
        "publication": {"const": false},
        "deployment": {"const": false},
        "external_action": {"const": false}
      }
    }
  }
}
