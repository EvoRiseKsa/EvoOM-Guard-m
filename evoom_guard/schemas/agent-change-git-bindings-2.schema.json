{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EvoRiseKsa/EvoOM-Guard-m/v4.6.0/evoom_guard/schemas/agent-change-git-bindings-2.schema.json",
  "title": "EvoOM Guard Agent Change raw-Git Bindings V2",
  "description": "Raw-Git bindings with an unambiguous framed candidate text-map identity. The legacy digest and size are retained only to bind the current Guard attestation and authorization byte-limit semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "git_object_format", "base_sha", "head_sha", "base_tree_sha", "head_tree_sha", "candidate_selection_profile", "candidate_identity", "legacy_guard_candidate_sha256", "legacy_guard_candidate_size", "changed_paths", "deleted_paths", "touched_paths", "policy_sha256", "verifier_pack_sha256"],
  "properties": {
    "format": {"const": "EVOGUARD_AGENT_CHANGE_GIT_BINDINGS_V2"},
    "git_object_format": {"enum": ["sha1", "sha256"]},
    "base_sha": {"$ref": "#/$defs/gitDigest"},
    "head_sha": {"$ref": "#/$defs/gitDigest"},
    "base_tree_sha": {"$ref": "#/$defs/gitDigest"},
    "head_tree_sha": {"$ref": "#/$defs/gitDigest"},
    "candidate_selection_profile": {"const": "EVOGUARD_AGENT_CHANGE_CANDIDATE_SELECTION_V1"},
    "candidate_identity": {"$ref": "#/$defs/candidateIdentity"},
    "legacy_guard_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "legacy_guard_candidate_size": {"type": "integer", "minimum": 0, "maximum": 67108864},
    "changed_paths": {"$ref": "#/$defs/pathArrayMaybeEmpty"},
    "deleted_paths": {"$ref": "#/$defs/pathArrayMaybeEmpty"},
    "touched_paths": {"$ref": "#/$defs/pathArray"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "verifier_pack_sha256": {"$ref": "#/$defs/nullableSha256"}
  },
  "$defs": {
    "gitDigest": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "size", "file_count"],
      "properties": {
        "format": {"const": "EVOGUARD_CANDIDATE_TEXT_MAP_V2"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file_count": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "pathArray": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
    "pathArrayMaybeEmpty": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}}
  }
}
